<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
    <TextView android:id="@+id/txtCartName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#212121" android:textSize="15sp"/>
    <TextView android:id="@+id/txtCartSubtotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:textStyle="bold"/>
    <Button android:id="@+id/btnMinus" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp" android:backgroundTint="#C62828" android:text="-"/>
    <Button android:id="@+id/btnPlus" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="4dp" android:minWidth="0dp" android:padding="0dp" android:backgroundTint="#2E7D32" android:text="+"/>
</LinearLayout>