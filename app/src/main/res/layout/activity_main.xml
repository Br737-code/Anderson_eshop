<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Anderson's Foodland Official Logo Wrapped in a Circle -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="240dp"
        android:layout_height="240dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="120dp"
        app:cardElevation="4dp"
        app:strokeColor="#EE1C25"
        app:strokeWidth="6dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Anderson Foodland Official Logo"
            android:padding="32dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/app_logo_foreground" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="ANDERSON\'S FOODLAND"
        android:textColor="#EE1C25"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Freshness you can taste • Value you can trust"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="15sp"
        android:textStyle="italic" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnProducts"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="48dp"
        android:backgroundTint="#2E7D32"
        android:text="View Products"
        android:textAllCaps="false"
        android:textSize="17sp"
        app:cornerRadius="16dp"
        app:elevation="2dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCategories"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#2E7D32"
        android:text="Categories"
        android:textAllCaps="false"
        android:textSize="17sp"
        app:cornerRadius="16dp"
        app:elevation="2dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCart"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#F57C00"
        android:text="Shopping Cart"
        android:textAllCaps="false"
        android:textSize="17sp"
        app:cornerRadius="16dp"
        app:elevation="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="start|center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cbDarkTheme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dark theme"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
