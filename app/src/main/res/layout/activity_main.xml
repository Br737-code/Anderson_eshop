<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Anderson's Foodland Official Logo Container -->
    <androidx.cardview.widget.CardView
        android:layout_width="260dp"
        android:layout_height="260dp"
        app:cardCornerRadius="130dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Anderson Foodland Official Logo"
            android:padding="32dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher_foreground" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="ANDERSON\'S FOODLAND"
        android:textColor="#EE1C25"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Freshness you can taste • Value you can trust"
        android:textColor="#555555"
        android:textSize="14sp"
        android:textStyle="italic" />

    <Button
        android:id="@+id/btnProducts"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="40dp"
        android:backgroundTint="#2E7D32"
        android:text="View Products"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnCategories"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#2E7D32"
        android:text="Categories"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnCart"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#F57C00"
        android:text="Shopping Cart"
        android:textSize="16sp" />
</LinearLayout>